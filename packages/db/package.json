{
  "name": "@mangy/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./model": {
      "default": "./src/model/index.ts"
    },
    "./model/*": {
      "default": "./src/model/*.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc -b",
    "db:migrate": "bun --env-file=../../.env --env-file=../../.env.local run src/migrate.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@mangy/env": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@mangy/config": "workspace:*",
    "typescript": "catalog:"
  }
}
