{
  "name": "mangy",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.5",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.2",
      "better-auth": "^1.7.7",
      "effect": "4.0.2",
      "@effect/platform-bun": "4.0.2",
      "@effect/sql-pg": "4.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "oxfmt . && oxlint .",
    "lint": "oxfmt --check . && oxlint .",
    "lint:fix": "oxlint --fix .",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test:sources": "bun --cwd packages/source-sdk test",
    "test:sources:live": "LIVE_SOURCE_TESTS=1 bun --cwd packages/source-sdk test:live",
    "test:routes:live": "LIVE_SOURCE_TESTS=1 bun --cwd apps/server test:live-routes",
    "dev:worker": "turbo -F worker dev",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "test:integration": "turbo -F server test:integration",
    "db:push": "turbo -F @mangy/db db:push",
    "db:studio": "turbo -F @mangy/db db:studio",
    "db:generate": "turbo -F @mangy/db db:generate",
    "db:migrate": "turbo -F @mangy/db db:migrate",
    "db:adopt": "turbo -F @mangy/db db:adopt",
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "postinstall": "bunx bun2nix -o bun.nix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "catalog:",
    "bun2nix": "*",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "^7.12.4"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  },
  "packageManager": "bun@1.3.4"
}
