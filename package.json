{
  "name": "mangy",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "better-auth": "^1.4.9"
    }
  },
  "type": "module",
  "scripts": {
    "check": "biome check --write .",
    "lint": "ultracite check",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test:sources": "bun --cwd packages/source-sdk test",
    "test:sources:live": "LIVE_SOURCE_TESTS=1 bun --cwd packages/source-sdk test:live",
    "test:routes:live": "LIVE_SOURCE_TESTS=1 bun --cwd apps/server test:live-routes",
    "dev:worker": "turbo -F worker dev",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "test:integration": "turbo -F server test:integration",
    "db:push": "turbo -F @mangy/db db:push",
    "db:studio": "turbo -F @mangy/db db:studio",
    "db:generate": "turbo -F @mangy/db db:generate",
    "db:migrate": "turbo -F @mangy/db db:migrate",
    "db:start": "turbo -F @mangy/db db:start",
    "db:watch": "turbo -F @mangy/db db:watch",
    "db:stop": "turbo -F @mangy/db db:stop",
    "db:down": "turbo -F @mangy/db db:down"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "catalog:",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "6.5.0"
  },
  "packageManager": "bun@1.3.4"
}
