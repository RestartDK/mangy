{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "check-types": "tsc -b",
    "dev": "bun --env-file=../../.env --env-file=../../.env.local run --hot src/index.ts",
    "start": "./server",
    "test:integration": "bun --env-file=../../.env --env-file=../../.env.local test tests/integration.test.ts",
    "test:live-routes": "bun --env-file=../../.env --env-file=../../.env.local run tests/live-routes.ts"
  },
  "dependencies": {
    "@mangy/auth": "workspace:*",
    "@mangy/db": "workspace:*",
    "@mangy/env": "workspace:*",
    "@mangy/push": "workspace:*",
    "@mangy/source-sdk": "workspace:*",
    "@elysiajs/cors": "^1.3.3",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.3.21",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mangy/config": "workspace:*",
    "@types/bun": "catalog:",
    "fflate": "^0.8.2",
    "playwright": "^1.53.2",
    "typescript": "catalog:"
  }
}
