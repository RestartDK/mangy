    "@elysiajs/cors": "^1.3.3",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.3.21",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@mangy/config": "workspace:*"
  }
