{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "rootDirs": ["."],
    "paths": {
      "@/*": ["./src/*", "../server/src/*"],
      "@server/*": ["../server/src/*"]
    }
  },
  "exclude": ["dist"]
}
